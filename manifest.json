{
  "manifest_version": 3,
  "name": "Notion Clipper with Notes",
  "version": "1.0.0",
  "description": "Clip web pages to Notion with custom notes",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.notion.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
